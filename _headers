# Browser caching for static assets (Cloudflare reads this file; it is not served).
# File names carry no content hash, so lifetimes are bounded: a font changes rarely,
# a replaced photo kept under the same name reaches returning visitors within a week.
# index.html keeps Cloudflare's default (revalidate every visit), so menu and price
# edits show up at once.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
